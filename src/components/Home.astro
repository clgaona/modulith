---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import PreviewBar from './PreviewBar.astro';
import { coverage, directions, type DirectionId, type HeadlineId } from '../config/site';
interface Props { direction?: DirectionId; headline?: HeadlineId }
const { direction = 'editorial', headline = 'claridad' } = Astro.props;
const entries = [
  { title: 'Quiero diseñar', description: 'Dar forma a una casa que responda a mis prioridades.', target: '#diseno' },
  { title: 'Ya tengo un diseño', description: 'Revisar lo que tengo y preparar el alcance de construcción.', target: '#construccion' },
  { title: 'Estoy buscando lote', description: 'Ordenar qué revisar antes de decidir una compra.', target: '#orientacion' },
  { title: 'Quiero organizar el proyecto completo', description: 'Conectar las etapas, las decisiones y sus responsables.', target: '#coordinacion' },
];
const stages = [
  { id: 'orientacion', name: 'Orientación', description: 'Una conversación para entender dónde estás y cuál puede ser tu siguiente paso.', note: 'Un punto de partida' },
  { id: 'diagnostico', name: 'Diagnóstico', description: 'Ordenar información, vacíos y decisiones cuando una revisión acotada aporte valor.', note: 'Cuando lo necesitas' },
  { id: 'diseno', name: 'Diseño', description: 'Traducir tus prioridades en espacios, contrastando el diseño con el sitio y tu objetivo económico.', note: 'De la idea al proyecto' },
  { id: 'coordinacion', name: 'Coordinación y planeación', description: 'Precisar alcance, presupuesto, dependencias y responsables de las etapas que contrates.', note: 'Conectar las decisiones' },
  { id: 'permisos', name: 'Permisos', description: 'Coordinar documentos y trámites según el alcance y los profesionales correspondientes.', note: 'Preparar el avance' },
  { id: 'construccion', name: 'Construcción', description: 'Revisar documentación y acordar condiciones antes de contratar obra, también con diseño existente.', note: 'Del proyecto a la obra' },
];
---
<BaseLayout direction={direction} title={`Modulith · ${directions[direction].name}`}>
  <PreviewBar direction={direction} headline={headline} />
  <Header />
  <main id="contenido">
    <Hero headline={headline} />
    <section class="entry-section section-pad" aria-labelledby="entry-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">01 / Tu punto de partida</p>
          <div><h2 id="entry-title">No todos los proyectos<br class="desktop-break" /> empiezan igual.</h2><p>Con lote, sin lote o con un diseño existente. Empecemos por lo que necesitas hoy.</p></div>
        </div>
        <div class="entry-grid">
          {entries.map((entry, index) => <a class="entry-link" href={entry.target}><span class="entry-number">0{index + 1}</span><div><h3>{entry.title}</h3><p>{entry.description}</p></div><span class="entry-arrow" aria-hidden="true">↗</span></a>)}
        </div>
      </div>
    </section>
    <section id="servicios" class="services-section section-pad container" aria-labelledby="services-title">
      <div class="section-heading">
        <p class="eyebrow">02 / Por etapas</p>
        <div><h2 id="services-title">Puedes entrar en<br class="desktop-break" /> la etapa que necesitas.</h2><p>Las etapas se acuerdan por separado. El presupuesto y la planeación se actualizan a medida que el proyecto avanza.</p></div>
      </div>
      <div class="service-list">
        {stages.map((stage, index) => <article class="service-row" id={stage.id}><span class="service-number">0{index + 1}</span><h3>{stage.name}</h3><p>{stage.description}</p><span class="service-note">{stage.note}</span></article>)}
      </div>
      <p class="services-footnote">No necesitas contratar la cadena completa. Definimos juntos qué etapa tiene sentido para tu proyecto.</p>
    </section>
    <section class="method-section section-pad" aria-labelledby="method-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">03 / Nuestra manera de trabajar</p>
          <div><h2 id="method-title">Prioridades, alcance y<br class="desktop-break" /> responsabilidades visibles.</h2><p>Modulith es tu interlocutor principal y coordina las etapas que contrates. Cada especialidad tiene responsables definidos según el encargo.</p></div>
        </div>
        <p class="sample-label">Ejemplo ilustrativo del proceso</p>
        <div class="method-grid">
          <article><div class="sample-graphic sample-brief" aria-hidden="true"><span></span><span></span><span></span><span></span></div><p class="eyebrow">01 / Brief</p><h3>Lo que importa para ti.</h3><p>Ordenamos prioridades, información del sitio y preguntas por resolver antes de diseñar.</p></article>
          <article><div class="sample-graphic sample-decision" aria-hidden="true"><span>Pregunta</span><span>Decisión → Responsable</span></div><p class="eyebrow">02 / Decisiones</p><h3>Un siguiente paso claro.</h3><p>Registramos qué se acuerda, quién lo revisa y qué hace falta para continuar.</p></article>
          <article><div class="sample-graphic sample-scope" aria-hidden="true"><span>Incluido <i>＋</i></span><span>Por confirmar <i>↗</i></span></div><p class="eyebrow">03 / Alcance</p><h3>Saber qué estamos acordando.</h3><p>Precisamos entregables, límites y responsabilidades de cada etapa antes de contratarla.</p></article>
        </div>
      </div>
    </section>
    <section class="coverage-section container section-pad" aria-labelledby="coverage-title">
      <p class="eyebrow">Cerca del proyecto, desde el inicio.</p>
      <h2 id="coverage-title">Nuestra base es {coverage.base}.</h2>
      <div class="coverage-body"><p>Evaluamos proyectos de construcción cercanos en Antioquia caso por caso y proyectos de diseño remoto en {coverage.remoteDesign.toLowerCase()}.</p><p>{coverage.availability}</p></div>
    </section>
    <aside id="preview-pendientes" class="preview-pending container" aria-labelledby="pending-title">
      <p class="eyebrow">Sobre este preview</p>
      <h2 id="pending-title">Estamos comparando la dirección visual.</h2>
      <p>Contacto, guías y el quiz se construirán en las siguientes fases, después de tu aprobación. Este preview no recibe solicitudes ni datos personales.</p>
      <a class="text-link" href="/preview/">Volver a la comparación <span aria-hidden="true">↗</span></a>
    </aside>
  </main>
  <footer class="site-footer container"><a class="wordmark" href="/">modulith<span aria-hidden="true">.</span></a><p>Diseño y construcción de vivienda, por etapas.</p><span>Preview de diseño · 2026</span></footer>
</BaseLayout>
