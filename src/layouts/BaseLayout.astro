---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/source-serif-4/latin-400.css';
import '../styles/global.css';
interface Props { title?: string; direction?: 'editorial' | 'mineral' }
const { title = 'Modulith · Diseño y construcción de vivienda', direction = 'editorial' } = Astro.props;
const canonical = ['/404', '/404/', '/404.html'].includes(Astro.url.pathname)
  ? undefined
  : new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es" data-direction={direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Preview visual de Modulith: diseño y construcción de vivienda, por etapas." />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical.href} />}
    <link rel="icon" href="/favicon.svg?v=modulith-m" type="image/svg+xml" sizes="any" />
    <link rel="alternate icon" href="/favicon-32.png?v=modulith-m" type="image/png" sizes="32x32" />
    <link rel="alternate icon" href="/favicon-16.png?v=modulith-m" type="image/png" sizes="16x16" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
