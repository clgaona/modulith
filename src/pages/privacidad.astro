---
import { Content, getHeadings } from '../approved/privacy.md';

const canonical = new URL('/privacidad/', Astro.site);
const sections = getHeadings().filter(heading => heading.depth === 2);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Política de Tratamiento de Datos Personales | MODULITH</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg?v=modulith-m" type="image/svg+xml" sizes="any" />
    <link rel="alternate icon" href="/favicon-32.png?v=modulith-m" type="image/png" sizes="32x32" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="privacy-document">
      <a class="brand" href="/#empieza" aria-label="Modulith, volver al quiz"><span class="brand-symbol"><img src="/assets/logo-modulith.svg" alt="" width="1024" height="1024" /></span><span class="brand-name">MODULITH</span></a>
      <details class="document-index">
        <summary>Índice del documento</summary>
        <nav aria-label="Apartados de la política">
          <ol>
            {sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}
          </ol>
        </nav>
      </details>
      <article class="policy-content" aria-label="Política de Tratamiento de Datos Personales">
        <Content />
      </article>
      <a class="return-link" href="/#empieza">Volver al quiz</a>
    </main>
  </body>
</html>
<style>
  body { background: #202e28; color: #eff3ec; font-family: 'Instrument Sans', Arial, sans-serif; }
  .privacy-document { max-width: 880px; margin-inline: auto; padding: 64px 32px 80px; }
  .document-index { margin: 48px 0 40px; border-block: 1px solid #526454; }
  summary { padding-block: 18px; cursor: pointer; font-size: 15px; line-height: 1.5; }
  nav ol { list-style: none; padding: 0 0 20px; margin: 0; }
  nav a { display: block; padding-block: 7px; font-size: 15px; line-height: 1.5; }
  .policy-content { overflow-wrap: anywhere; }
  .policy-content :global(h1) { max-width: 800px; margin: 0 0 28px; font-size: 48px; line-height: 1.12; font-weight: 500; }
  .policy-content :global(h1 + p) { color: #c6d0c4; font-size: 14px; line-height: 1.8; }
  .policy-content :global(p), .policy-content :global(li) { font-size: 17px; line-height: 1.65; }
  .policy-content :global(p) { margin-block: 22px; }
  .policy-content :global(h2) { border-top: 1px solid #526454; margin: 48px 0 24px; padding-top: 32px; font-size: 25px; line-height: 1.3; font-weight: 500; scroll-margin-top: 24px; }
  .policy-content :global(ul), .policy-content :global(ol) { padding-left: 24px; }
  .policy-content :global(li + li) { margin-top: 14px; }
  .policy-content :global(strong) { font-weight: 600; }
  .policy-content :global(a), nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .return-link { display: inline-block; padding-block: 12px; margin-top: 32px; text-decoration: underline; text-underline-offset: 5px; }
  :global(.privacy-document a:focus-visible), summary:focus-visible { outline: 2px solid #d9c49c; outline-offset: 5px; }
  @media (max-width: 700px) {
    .privacy-document { padding: 32px 24px 56px; }
    .document-index { margin-block: 32px; }
    .policy-content :global(h1) { font-size: 34px; }
    .policy-content :global(p), .policy-content :global(li) { font-size: 16px; }
    .policy-content :global(h2) { font-size: 23px; margin-top: 40px; padding-top: 28px; }
  }
</style>
